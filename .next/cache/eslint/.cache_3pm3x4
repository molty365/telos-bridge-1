res/transactionStore';\nimport {Icon} from '@/core/ui/Icon';\nimport {Box, Stack} from '@/core/ui/system';\n\ninterface TransactionItemProps {\n  tx: Transaction;\n}\n\n// naive\nfunction isCrossChainTx(\n  tx: Transaction,\n): tx is Transaction<{srcChainId: number; dstChainId: number}> {\n  const input = tx.input as any;\n  if (input && input.srcChainId && input.dstChainId) return true;\n  return false;\n}\n\n// naive\nfunction isBridgeTransaction(tx: Transaction): tx is Transaction<TransferInput> {\n  if (!isCrossChainTx(tx)) return false;\n  const input = tx.input as TransferInput;\n  if (!input.amount) return false;\n  if (!input.srcCurrency) return false;\n  if (!input.dstCurrency) return false;\n  return true;\n}\n\nexport const TransactionItem = observer(({tx}: TransactionItemProps) => {\n  const isSuccess = tx.completed;\n  const isError = !!tx.error;\n  const isPending = !isError && !isSuccess;\n  const link = isCrossChainTx(tx)\n    ? getScanLink(tx.chainId, tx.txHash)\n    : getTransactionLink(tx.chainId, tx.txHash);\n\n  const input: TransferInput | undefined = isBridgeTransaction(tx) ? tx.input : undefined;\n\n  return (\n    <Box sx={{display: 'flex', mb: 2, width: '100%'}}>\n      <a href={link} target='_blank' rel='noreferrer'>\n        <Icon type='blockchainExplorer' size={16} sx={{color: (t) => t.palette.text.secondary}} />\n      </a>\n      <Box\n        typography='p3'\n        sx={{flex: 1, ml: 1, mr: 2}}\n        color={isSuccess ? 'text.primary' : 'text.secondary'}\n      >\n        <Stack direction='row' justifyContent='space-between'>\n          <Box>{tx.type}</Box>\n          <Box> {input && `${input.amount.toSignificant()} ${input.srcCurrency.symbol}`}</Box>\n        </Stack>\n      </Box>\n\n      {isSuccess && (\n        <Icon\n          type='success'\n          size={16}\n          sx={(t) => ({\n            color: t.palette.primary.contrastText,\n            fill: t.palette.text.secondary,\n          })}\n        />\n      )}\n      {isPending && <Icon type='spinner' size={16} />}\n      {isError && <Icon type='error' size={16} />}\n    </Box>\n  );\n});\n","/Users/jesse/repos/telos-bridge/src/features/bridge/ui/UnclaimedTokensPanel.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/colorPalettes.ts",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/config/createWallets.ts",["751"],[],"/Users/jesse/repos/telos-bridge/src/features/core/context/JsonRpcProviderContext.ts",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/hooks/useGasPrice.ts",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/hooks/useHasMounted.ts",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/hooks/useMediaQuery.ts",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/hooks/usePagination.ts",[],["752"],"/Users/jesse/repos/telos-bridge/src/features/core/hooks/useSessionStorageBoolean.ts",["753"],[],"import {useEffect, useState} from 'react';\n\nexport function useSessionStorageBoolean(key: string): [boolean, (value: boolean) => void] {\n  const [hasKey, setHasKey] = useState<boolean>(false);\n\n  useEffect(() => {\n    if (sessionStorage.getItem(key)) {\n      setHasKey(true);\n    }\n  }, []);\n\n  return [hasKey, setHasKey];\n}\n","/Users/jesse/repos/telos-bridge/src/features/core/hooks/useSystemAppearancePreference.ts",["754"],[],"import React from 'react';\n\nexport function useSystemAppearancePreference<Dark, Light>({\n  dark,\n  light,\n}: {\n  dark: Dark;\n  light: Light;\n}): Dark | Light {\n  const matchMediaRef = React.useRef<MediaQueryList | null>(null);\n  const [isDark, setIsDark] = React.useState(false);\n\n  const onChangeListener = (e: MediaQueryListEvent) => setIsDark(e.matches);\n\n  // current system scheme\n  React.useEffect(() => {\n    matchMediaRef.current = window.matchMedia('(prefers-color-scheme: dark)');\n  }, [matchMediaRef]);\n\n  // on system scheme change\n  React.useEffect(() => {\n    const matchMedia = matchMediaRef.current;\n    if (matchMedia) {\n      matchMedia.addEventListener('change', onChangeListener);\n      setIsDark(matchMedia.matches);\n    }\n\n    return () => matchMedia?.removeEventListener('change', onChangeListener);\n  }, [matchMediaRef, onChangeListener]);\n\n  return isDark ? dark : light;\n}\n","/Users/jesse/repos/telos-bridge/src/features/core/hooks/useToggle.ts",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/hooks/useUserThemePreference.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/hooks/useVisibilityChange.ts",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/sdk/CachedDstConfigProvider.ts",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/sdk/TokenListProvider.ts",["755","756","757"],[],"import {\n  GetTokenListOptions,\n  TokenList,\n  TokenListItem,\n  TokenListProvider as ITokenListProvider,\n} from '@layerzerolabs/ui-core';\n\nimport {trpcClient} from '../utils/trpc';\n\nexport class TokenListProvider implements ITokenListProvider {\n  async getTokenList(options?: GetTokenListOptions | undefined): Promise<TokenList<TokenListItem>> {\n    return trpcClient.tokens.query();\n  }\n}\n","/Users/jesse/repos/telos-bridge/src/features/core/stores/airdropStore.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/stores/balanceStore.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/stores/fiatStore.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/stores/lzStore.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/stores/tokenStore.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/stores/transactionStore.tsx",["758"],["759"],"import {waitForMessageReceived} from '@layerzerolabs/scan-client';\nimport {register} from '@layerzerolabs/ui-superjson';\nimport {autorun, makeAutoObservable, toJS} from 'mobx';\nimport SuperJSON from 'superjson';\n//\nregister(SuperJSON);\n\ntype TransactionType = string;\ntype Confirmation = {txHash: string; chainId: number};\ntype Timestamp = number;\ntype Optional<T, K extends keyof T> = Omit<T, K> & Partial<Pick<T, K>>;\n\ninterface TransactionProps<Input> {\n  type: TransactionType;\n  input: Input;\n  chainId: number;\n  expectedDate: Timestamp;\n  submittedDate: Timestamp;\n  error: unknown | undefined;\n  txHash: string;\n  confirmation: Confirmation | undefined;\n  completed: boolean;\n}\ntype TransactionConstructorProps<Input> = Optional<\n  TransactionProps<Input>,\n  'confirmation' | 'completed' | 'error' | 'completed' | 'submittedDate'\n>;\n\nexport class Transaction<Input = unknown> implements TransactionProps<Input> {\n  type: TransactionType;\n  input: Input;\n  chainId: number;\n  expectedDate: Timestamp;\n  submittedDate: Timestamp = timeStamp();\n  error: unknown | undefined = undefined;\n  txHash: string;\n  confirmation: Confirmation | undefined = undefined;\n  completed = false;\n\n  constructor(props: TransactionConstructorProps<Input>) {\n    makeAutoObservable(this);\n    this.chainId = props.chainId;\n    this.txHash = props.txHash;\n    this.expectedDate = props.expectedDate;\n    this.input = props.input;\n    this.type = props.type;\n  }\n\n  update(props: Partial<TransactionProps<Input>>) {\n    Object.assign(this, props);\n  }\n\n  get srcChainId(): number {\n    return this.chainId;\n  }\n\n  get dstChainId(): number | undefined {\n    // put your logic here\n    // eslint-disable-next-line @typescript-eslint/no-explicit-any\n    const input = this.input as any;\n    if (input) {\n      if (typeof input.dstChainId === 'number') {\n        return input.dstChainId;\n      }\n    }\n  }\n}\n\nexport class TransactionStore {\n  transactions: Transaction<unknown>[] = [];\n  constructor() {\n    makeAutoObservable(this, {}, {autoBind: true});\n  }\n\n  get isPending(): boolean {\n    return this.pendingTransactions.length > 0;\n  }\n  get hasPending(): boolean {\n    return this.isPending;\n  }\n  get recentTransactions() {\n    return this.transactions.slice().reverse();\n  }\n  get pendingTransactions() {\n    return this.recentTransactions.filter(\n      (transaction) => !transaction.completed && !transaction.error,\n    );\n  }\n  create<T>(props: TransactionConstructorProps<T>) {\n    const tx = new Transaction(props);\n    this.transactions.push(tx);\n    return tx;\n  }\n\n  saveSnapshot() {\n    if (typeof localStorage === 'undefined') return;\n    try {\n      const snapshot = this.transactions.map((t) => toJS(t));\n      localStorage.setItem('transactions', SuperJSON.stringify(snapshot));\n    } catch (e) {\n      console.error(e);\n      //\n    }\n  }\n\n  restoreSnapshot() {\n    if (typeof localStorage === 'undefined') return;\n    try {\n      const serialized = localStorage.getItem('transactions');\n      if (!serialized) return;\n      this.transactions = SuperJSON.parse<Transaction[]>(serialized).map(\n        (tx: Transaction) => new Transaction(tx),\n      );\n      this.transactions\n        .filter((tx) => isCrossChainTx(tx) && !tx.completed && !tx.error)\n        .forEach((tx) => {\n          if (!tx.txHash) return;\n          waitForMessageReceived(tx.chainId, tx.txHash, 5_000).then(\n            (message) => {\n              tx.update({\n                completed: true,\n                confirmation: {\n                  chainId: message.dstChainId,\n                  txHash: message.dstTxHash,\n                },\n              });\n            },\n            (error) => {\n              tx.update({error});\n            },\n          );\n        });\n    } catch (e) {\n      console.error(e);\n      //\n    }\n  }\n}\n\nexport function initTransactionStore(store: TransactionStore) {\n  if (typeof localStorage === 'undefined') return;\n  store.restoreSnapshot();\n  recordTransactions(store);\n}\n\nfunction recordTransactions(store: TransactionStore) {\n  return autorun(() => {\n    store.saveSnapshot();\n  });\n}\n\nfunction isCrossChainTx(tx: Transaction) {\n  const input: any = tx.input;\n  if (!input) return false;\n  return input.srcChainId && input.dstChainId;\n}\n\nconst timeStamp = () => Math.floor(Date.now() / 1000);\n\nexport const transactionStore = new TransactionStore();\n","/Users/jesse/repos/telos-bridge/src/features/core/stores/uiStore.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/stores/utils.ts",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/stores/walletStore.ts",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/theme.ts",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/ui/Alert.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/ui/Banner.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/ui/Bar.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/ui/Button.tsx",[],["760"],"/Users/jesse/repos/telos-bridge/src/features/core/ui/Chip.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/ui/ConnectButtons.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/ui/CopyButton.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/ui/CurrencyIcon.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/ui/CustomHtmlHead.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/ui/Details.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/ui/Icon.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/ui/Input.tsx",[],["761"],"/Users/jesse/repos/telos-bridge/src/features/core/ui/InputsGroup.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/ui/Layout.tsx",["762","763","764"],[],"/Users/jesse/repos/telos-bridge/src/features/core/ui/ListItem.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/ui/Modal.tsx",["765"],[],"import * as Dialog from '@radix-ui/react-dialog';\nimport React from 'react';\n\nimport {styled, TypographyProps} from '@/core/ui/system';\nimport * as animation from '@/core/utils/animations';\n\nimport {Icon} from './Icon';\n\nexport type ModalProps = {\n  children: React.ReactNode;\n  onClose: () => void;\n  open: boolean;\n  title: React.ReactNode;\n  overlay?: boolean;\n  topAdornment?: React.ReactNode;\n  onOpenAutoFocus?: Dialog.FocusScopeProps['onMountAutoFocus'];\n};\n\nconst DialogOverlay = styled(Dialog.Overlay)(() => ({\n  background: 'rgba(0 0 0 / 0.72)',\n  position: 'fixed',\n  top: 0,\n  left: 0,\n  right: 0,\n  bottom: 0,\n  display: 'grid',\n  placeItems: 'center',\n  overflowY: 'auto',\n  \"&[data-state='open']\": {\n    animation: animation.fadeIn,\n  },\n  \"&[data-state='closed']\": {\n    animation: animation.fadeOut,\n    opacity: 0,\n  },\n}));\n\nconst DialogContent = styled(Dialog.Content, {name: 'Modal-DialogContent'})(({theme}) => ({\n  pointerEvents: 'none',\n  backgroundColor: theme.palette.background.paper,\n  maxWidth: '100%',\n  position: 'fixed',\n  top: '50%',\n  left: '50%',\n  transform: 'translate(-50%, -50%)',\n  zIndex: 10,\n  paddingTop: 16,\n  display: 'flex',\n  overflow: 'hidden',\n  flexDirection: 'column',\n  fontFamily: (theme.typography as TypographyProps).fontFamily,\n  borderRadius: theme.shape.borderRadius,\n  width: '100%',\n  height: '100%',\n  \"&[data-state='open']\": {\n    animation: animation.modalContentIn,\n  },\n  \"&[data-state='closed']\": {\n    animation: animation.modalContentOut,\n    opacity: 0,\n  },\n\n  [theme.breakpoints.up('md')]: {\n    width: 432,\n    height: 584,\n  },\n}));\n\nconst DialogTitle = styled(Dialog.Title)(({theme}) => ({\n  display: 'flex',\n  justifyContent: 'space-between',\n  marginBottom: 20,\n  marginRight: 16,\n  marginLeft: 16,\n  color: theme.palette.text.primary,\n  ...theme.typography.p1,\n}));\n\nconst DialogClose = styled(Dialog.Close)(({theme}) => ({\n  backgroundColor: 'transparent',\n  border: 0,\n  position: 'absolute',\n  top: 23,\n  right: 19,\n  cursor: 'pointer',\n  color: theme.palette.text.primary,\n  paddingRight: 0,\n  '&:hover': {\n    filter: 'brightness(1.5)',\n  },\n}));\n\nconst ScrollContainer = styled('div', {name: 'ScrollContainer'})(({theme}) => ({\n  overflowY: 'scroll',\n  flex: 1,\n  display: 'flex',\n  flexDirection: 'column',\n  '&::-webkit-scrollbar': {\n    width: '1px',\n  },\n  '&::-webkit-scrollbar-track': {\n    background: 'transparent',\n  },\n  '&::-webkit-scrollbar-thumb': {\n    background: theme.palette.text.secondary,\n  },\n  '&::-webkit-scrollbar-thumb:hover': {\n    background: theme.palette.text.secondary,\n  },\n}));\n\nconst TopAdornment = styled('div', {name: 'ModalTopAdornment'})(() => ({\n  marginBottom: '32px',\n}));\n\nexport const Modal = (props: ModalProps) => {\n  const {\n    title,\n    open,\n    onClose,\n    children,\n    topAdornment,\n    overlay = true,\n    onOpenAutoFocus = () => {},\n  } = props;\n  return (\n    <Dialog.Root open={open} onOpenChange={(isOpen) => !isOpen && onClose?.()}>\n      <Dialog.Portal>\n        {overlay && <DialogOverlay />}\n        <DialogContent onOpenAutoFocus={onOpenAutoFocus}>\n          <DialogTitle>{title}</DialogTitle>\n          {topAdornment && <TopAdornment>{topAdornment}</TopAdornment>}\n          <ScrollContainer>{children}</ScrollContainer>\n          <DialogClose asChild>\n            <Icon type='close' size={16} />\n          </DialogClose>\n        </DialogContent>\n      </Dialog.Portal>\n    </Dialog.Root>\n  );\n};\n","/Users/jesse/repos/telos-bridge/src/features/core/ui/ModalList.tsx",["766"],[],"import {ChainId} from '@layerzerolabs/lz-sdk';\nimport React from 'react';\n\nimport {ListItem} from './ListItem';\nimport {Modal, ModalProps} from './Modal';\n\nexport type ModalListProps<Item extends ModalListItem> = {\n  title?: React.ReactNode;\n  items: Item[];\n  onSelect?: (chainId: ChainId) => void;\n  renderItem?: (item: Item, index: number) => React.ReactElement;\n} & Omit<ModalProps, 'children' | 'title'>;\n\ntype ModalListItem = {\n  text?: string;\n  disabled?: boolean;\n  key?: React.Key;\n};\n\nexport const ModalList: React.FC<ModalListProps<{disabled: boolean; chainId: ChainId}>> = ({\n  items,\n  title = 'Network',\n  onSelect = () => {},\n  renderItem = (item: ModalListItem, index: number) => {\n    return <ListItem key={index} topLeft={item.text} />;\n  },\n  ...modalProps\n}) => {\n  return (\n    <Modal title={title} {...modalProps}>\n      {items.map((item, index) =>\n        React.cloneElement(renderItem(item, index), {\n          key: index,\n          onClick: () => {\n            if (!item.disabled) {\n              onSelect(item.chainId);\n            }\n          },\n        }),\n      )}\n    </Modal>\n  );\n};\n","/Users/jesse/repos/telos-bridge/src/features/core/ui/NetworkIcon.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/ui/NetworkListModal.tsx",["767"],[],"import {ChainId} from '@layerzerolabs/lz-sdk';\nimport {getNetwork} from '@layerzerolabs/ui-core';\nimport React from 'react';\n\nimport {ListItem} from './ListItem';\nimport {Modal, ModalProps} from './Modal';\n\nexport type NetworkListModalProps = {\n  title?: React.ReactNode;\n  options: NetworkListItem[];\n  onSelect?: (chainId: ChainId) => void;\n  renderOption?: (item: NetworkListItem, index: number) => React.ReactElement;\n} & Omit<ModalProps, 'children' | 'title'>;\n\ntype NetworkListItem = {\n  chainId: ChainId;\n  disabled?: boolean;\n  key?: React.Key;\n};\n\nexport const NetworkListModal: React.FC<NetworkListModalProps> = ({\n  options,\n  title = 'Network',\n  onSelect = () => {},\n  renderOption = (item, index) => {\n    const {chainId} = item;\n    const network = getNetwork(chainId);\n    return <ListItem key={index} topLeft={network.name} bottomLeft={network.symbol} />;\n  },\n  ...modalProps\n}) => {\n  return (\n    <Modal title={title} {...modalProps}>\n      {options.map((option, index) =>\n        React.cloneElement(renderOption(option, index), {\n          key: option.key ?? index,\n          onClick: () => {\n            if (!option.disabled) {\n              onSelect(option.chainId);\n            }\n          },\n        }),\n      )}\n    </Modal>\n  );\n};\n","/Users/jesse/repos/telos-bridge/src/features/core/ui/PageLayout.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/ui/Panel.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/ui/SearchBar.tsx",["768"],[],"import React from 'react';\n\nimport {styled} from '@/core/ui/system';\n\nimport {Icon} from './Icon';\nimport {Input} from './Input';\n\ninterface SearchBarProps {\n  onChange: React.ChangeEventHandler<HTMLInputElement>;\n  value: string;\n}\n\nconst InputWrapper = styled('div', {name: 'SearchBarWrapper'})(() => ({\n  maxWidth: 'calc(100% - 32px)',\n  margin: '0 auto',\n  width: '100%',\n  boxSizing: 'border-box',\n}));\n\nexport const SearchBar = (props: SearchBarProps) => {\n  const {value, onChange, ...inputProps} = props;\n  return (\n    <InputWrapper>\n      <Input\n        placeholder='Search'\n        value={value}\n        onChange={onChange}\n        startAdornment={\n          <Icon type='search' size={16} sx={{color: (t) => t.palette.text.secondary}} />\n        }\n        sx={{boxSizing: 'border-box'}}\n        {...inputProps}\n      />\n    </InputWrapper>\n  );\n};\n\nexport function useSimpleSearch({items, searchKey}: {items: Array<any>; searchKey: string}) {\n  const [query, setQuery] = React.useState('');\n  const filteredItems = items.filter((item) => item[searchKey]?.toLowerCase()?.includes(query));\n  return {\n    filteredItems,\n    query,\n    setQuery,\n  };\n}\n","/Users/jesse/repos/telos-bridge/src/features/core/ui/SelectButton.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/ui/Selector.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/ui/SlideIn.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/ui/SwapButton.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/ui/Switch.tsx",[],["769"],"/Users/jesse/repos/telos-bridge/src/features/core/ui/Tabs.tsx",["770","771","772","773","774","775","776"],[],"import * as React from 'react';\n\nimport {Box, styled, SxProps, Theme} from '@/core/ui/system';\n\ninterface CommonProps {\n  theme?: Theme;\n  as?: React.ElementType;\n  sx?: SxProps<Theme>;\n}\n\nexport type TabsProps = {\n  activeTab: string;\n  children: React.ReactElement<TabChildProps>[] | React.ReactElement<TabChildProps>;\n  setActiveTab: (_tab: string) => void;\n} & CommonProps;\n\ntype TabChildProps = {\n  children: React.ReactNode;\n  title: string;\n};\n\nconst STabs = styled(Box, {name: 'Tabs'})(() => ({\n  display: 'flex',\n  flexDirection: 'column',\n  height: '100%',\n}));\n\nconst STabsBar = styled('div', {name: 'TabsBar'})(({theme}) => ({\n  borderBottom: `1px solid ${theme.palette.divider}`,\n  marginBottom: 24,\n  position: 'relative',\n}));\n\nconst STab = styled('button', {name: 'Tab', shouldForwardProp: (props) => props !== 'active'})<{\n  active: boolean;\n}>(({theme, ...props}) => ({\n  border: 0,\n  backgroundColor: 'transparent',\n  outline: 'none',\n  cursor: 'pointer',\n  paddingBottom: 16,\n  color: props.active ? theme.palette.text.primary : theme.palette.text.secondary,\n  paddingLeft: 0,\n  paddingRight: 0,\n  textAlign: 'left',\n  marginRight: 12,\n  borderBottom: props.active ? `1px solid ${theme.palette.text.primary}` : '1px solid transparent',\n  ...theme.typography.p2,\n  '&:only-child': {\n    borderBottom: '1px solid transparent',\n  },\n  '&:hover': {\n    color: theme.palette.text.primary,\n  },\n  '&:not(:first-of-type)': {\n    marginLeft: 12,\n  },\n}));\n\nconst TabContent = styled('div', {name: 'TabContent'})(() => ({\n  flex: 1,\n  display: 'flex',\n  flexDirection: 'column',\n  alignItems: 'flex-start',\n}));\n\nexport const Tabs = (props: TabsProps) => {\n  const {children, activeTab, setActiveTab, sx} = props;\n  const childrenArray = React.Children.toArray(children) as React.ReactElement<TabChildProps>[];\n  const activeChild = childrenArray.find((child) => child.props.title === activeTab)!;\n  const activeIdx = childrenArray.indexOf(activeChild);\n  return (\n    <STabs sx={sx}>\n      <STabsBar>\n        {React.Children.map(childrenArray, ({props: {title}}) => (\n          <STab onClick={() => setActiveTab(title)} active={title === activeTab}>\n            {title}\n          </STab>\n        ))}\n      </STabsBar>\n      <TabContent>{activeChild?.props.children}</TabContent>\n    </STabs>\n  );\n};\n\nconst Tab = (_props: TabChildProps) => {\n  return null;\n};\n\nTabs.Tab = Tab;\n","/Users/jesse/repos/telos-bridge/src/features/core/ui/Toast.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/ui/Tooltip.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/ui/Tracker.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/ui/TrackerCarousel.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/ui/WalletDetails.tsx",["777"],[],"/Users/jesse/repos/telos-bridge/src/features/core/ui/WalletIcon.tsx",[],["778"],"/Users/jesse/repos/telos-bridge/src/features/core/ui/system/index.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/ui/system/types/theme.ts",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/utils/animations.ts",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/utils/formatAddress.ts",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/utils/formatRemainingTime.ts",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/utils/fromPromise.ts",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/utils/getScanLink.ts",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/utils/handleError.ts",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/utils/makePersistable.ts",["779"],[],"import {autorun, set, toJS} from 'mobx';\n\n// poor mans mobx-persist-store\nexport function makePersistable<T extends {[key: string]: any}>(\n  target: T,\n  options: {name: string},\n) {\n  if (typeof localStorage === 'undefined') return;\n  const storedJson = localStorage.getItem(options.name);\n  if (storedJson) {\n    set(target, JSON.parse(storedJson));\n  }\n  autorun(() => {\n    const value = toJS(target);\n    localStorage.setItem(options.name, JSON.stringify(value));\n  });\n}\n","/Users/jesse/repos/telos-bridge/src/features/core/utils/multicall.ts",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/utils/overrideImageSrcOnError.ts",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/utils/parseWalletError.ts",["780","781"],[],"function parseWalletErrorTitle(e: unknown) {\n  const title = (e as any)?.code === 4001 ? 'Transaction rejected' : 'Transaction failed';\n  return title;\n}\n\nfunction parseWalletErrorMessage(e: unknown) {\n  const any = e as any;\n  const code: string | undefined = any?.code;\n  if (code && typeof code === 'string') {\n    if (code === 'INSUFFICIENT_FUNDS') {\n      return ErrorMessage.INSUFFICIENT_FUNDS;\n    }\n  }\n  const reason: string | undefined = any?.reason;\n  if (reason && typeof reason === 'string') {\n    return reason;\n  }\n  const message: string | undefined = any?.message || any?.data?.message;\n  if (message && typeof message === 'string') {\n    if (typeof message === 'string') {\n      // aptos\n      if (message.includes('INSUFFICIENT_BALANCE_FOR_TRANSACTION_FEE')) {\n        return ErrorMessage.INSUFFICIENT_FUNDS;\n      }\n      // aptos\n      if (message.includes('RejectedByUser')) {\n        return ErrorMessage.REJECTED_BY_USER;\n      }\n      if (message.includes('insufficient funds for gas')) {\n        return ErrorMessage.INSUFFICIENT_FUNDS;\n      }\n    }\n    return message;\n  }\n  // last resort\n  const error = String(e ?? 'Unknown error');\n  return error;\n}\n\nenum ErrorMessage {\n  INSUFFICIENT_FUNDS = 'Insufficient funds for gas. Make sure you have enough gas.',\n  REJECTED_BY_USER = 'Transaction was rejected.',\n}\n\nexport function parseWalletError(e: unknown): {title: string; message: string} {\n  const title = parseWalletErrorTitle(e);\n  const message = parseWalletErrorMessage(e);\n  return {title, message};\n}\n","/Users/jesse/repos/telos-bridge/src/features/core/utils/sleep.ts",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/utils/timeStamp.ts",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/utils/trpc.ts",["782","783","784"],[],"import {createTRPCProxyClient, httpBatchLink} from '@trpc/client';\nimport {createTRPCNext} from '@trpc/next';\n\nimport type {AppRouter} from '../../../server/routers/_app';\n\nfunction getBaseUrl() {\n  if (typeof window !== 'undefined')\n    // browser should use relative path\n    return '';\n\n  if (process.env.VERCEL_URL)\n    // reference for vercel.com\n    return `https://${process.env.VERCEL_URL}`;\n\n  if (process.env.RENDER_INTERNAL_HOSTNAME)\n    // reference for render.com\n    return `http://${process.env.RENDER_INTERNAL_HOSTNAME}:${process.env.PORT}`;\n\n  // assume localhost\n  return `http://localhost:${process.env.PORT ?? 3000}`;\n}\n\nconst links = [\n  httpBatchLink({\n    /**\n     * If you want to use SSR, you need to use the server's full URL\n     * @link https://trpc.io/docs/ssr\n     **/\n    url: `${getBaseUrl()}/api/trpc`,\n\n    // You can pass any HTTP headers you wish here\n    async headers() {\n      return {\n        // authorization: getAuthCookie(),\n      };\n    },\n  }),\n];\n\nexport const trpc = createTRPCNext<AppRouter>({\n  config(opts) {\n    return {\n      links,\n    };\n  },\n  /**\n   * @link https://trpc.io/docs/ssr\n   **/\n  ssr: false,\n});\n\nexport const trpcClient = createTRPCProxyClient<AppRouter>({\n  links,\n});\n","/Users/jesse/repos/telos-bridge/src/features/core/utils/txProgressUtils.ts",[],[],"/Users/jesse/repos/telos-bridge/src/globals.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/pages/_app.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/pages/_document.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/pages/api/trpc/[trpc].ts",[],[],"/Users/jesse/repos/telos-bridge/src/pages/bridge.tsx",["785","786","787","788","789","790"],[],"/Users/jesse/repos/telos-bridge/src/server/routers/_app.ts",["791","792","793","794","795","796","797","798"],[],"import {\n  chainKeyToEndpointId,\n  Coin,\n  FiatCurrency,\n  Token,\n  TokenListItem,\n} from '@layerzerolabs/ui-core';\nimport {\n  CoinGeckoEndpoint,\n  //\n  CoinGeckoPriceProvider,\n  CoinMarketCapEndpoint,\n  CoinMarketCapPriceProvider,\n} from '@layerzerolabs/ui-price-sdk';\n\nimport {tokenList} from '../../tokenList';\nimport {procedure, router} from '../trpc';\n\nconst cmcProvider = new CoinMarketCapPriceProvider(\n  {\n    apiKey: 'b54bcf4d-1bca-4e8e-9a24-22ff2c3d462c',\n    endpoint: CoinMarketCapEndpoint.SANDBOX,\n  },\n  tokenList.filter((t) => t.coinMarketCapId) as any,\n);\n\nconst cgProvider = new CoinGeckoPriceProvider(\n  {\n    endpoint: CoinGeckoEndpoint.PUBLIC,\n  },\n  tokenList.filter((t) => t.coinGeckoId) as any,\n);\n\nconst provider = cgProvider;\n\nexport const appRouter = router({\n  tokens: procedure.query(async (opts) => {\n    const tokens = await Promise.all(\n      tokenList\n        .filter((t) => t.chainKey !== 'aptos')\n        .map(async (item) => {\n          const chainId = chainKeyToEndpointId(item.chainKey, 1);\n\n          const {address} = item;\n\n          const currency = address\n            ? Token.from({...item, address, chainId})\n            : Coin.from({...item, chainId});\n\n          const usd = await provider\n            .getCurrentPrice(currency, FiatCurrency.USD)\n            // ignore errors\n            .catch((e) => console.error(e));\n\n          const details: TokenListItem = {\n            chainKey: item.chainKey,\n            decimals: item.decimals,\n            symbol: item.symbol,\n            name: item.name,\n            address: item.address,\n            icon: item.coinMarketCapId\n              ? `https://s2.coinmarketcap.com/static/img/coins/128x128/${item.coinMarketCapId}.png`\n              : undefined,\n            price: {\n              USD: usd ?? null,\n            },\n          };\n\n          return details;\n        }),\n    );\n    return tokens;\n  }),\n});\n\n// export type definition of API\nexport type AppRouter = typeof appRouter;\n","/Users/jesse/repos/telos-bridge/src/server/trpc.ts",[],[],"/Users/jesse/repos/telos-bridge/src/tokenList.ts",[],[],"/Users/jesse/repos/telos-bridge/src/abi/bridgeAbi.js",[],[],"/Users/jesse/repos/telos-bridge/src/abi/oftAbi.js",[],[],"/Users/jesse/repos/telos-bridge/src/features/bridge/ui/OFTBridge.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/core/utils/platform.ts",[],[],"/Users/jesse/repos/telos-bridge/src/features/onft/hooks/useAllAssets.ts",[],[],"/Users/jesse/repos/telos-bridge/src/features/onft/hooks/useAssetMetadata.ts",[],[],"/Users/jesse/repos/telos-bridge/src/features/onft/hooks/useFilteredAssets.ts",[],[],"/Users/jesse/repos/telos-bridge/src/features/onft/hooks/useLocalGasOnDestination.ts",[],[],"/Users/jesse/repos/telos-bridge/src/features/onft/hooks/useOnftMetadataProviders.ts",[],[],"/Users/jesse/repos/telos-bridge/src/features/onft/hooks/usePendingAssets.ts",[],[],"/Users/jesse/repos/telos-bridge/src/features/onft/hooks/useToggle.ts",[],[],"/Users/jesse/repos/telos-bridge/src/features/onft/providers/OnftMetadataProvidersContext.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/onft/stores/onftStore.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/onft/stores/utils.ts",[],[],"/Users/jesse/repos/telos-bridge/src/features/onft/ui/BridgeTopBar.tsx",["799","800"],[],"import {Button} from '@/core/ui/Button';\nimport {styled, SxProps, Theme} from '@/core/ui/system';\n\nimport {onftStore} from '../stores/onftStore';\nimport {NetworkFilter} from './NetworkFilter';\nimport {ViewType, ViewTypeSwitch} from './ViewTypeSwitch';\n\ntype BridgeTopBarProps = {\n  viewType: ViewType;\n  setViewType?: (viewType: ViewType) => void;\n  onTransfer?: () => void;\n  sx?: SxProps<Theme>;\n};\n\nexport const BridgeTopBar = (props: BridgeTopBarProps) => {\n  const {viewType, setViewType = () => {}, onTransfer = () => {}, sx = {}} = props;\n  const {items} = onftStore.form;\n  return (\n    <TopBar sx={sx}>\n      <NetworkFilter />\n      <TopBarRightSection>\n        <ViewTypeSwitch value={viewType} onChange={setViewType} />\n        <Button\n          variant='primary'\n          onClick={onTransfer}\n          disabled={items.length === 0}\n          sx={{flex: {xs: 1}, whiteSpace: 'nowrap'}}\n          size='md'\n        >\n          Transfer\n          {items.length > 0 && ` (${items.length})`}\n        </Button>\n      </TopBarRightSection>\n    </TopBar>\n  );\n};\n\nconst TopBar = styled('div', {name: 'TopBar'})(({theme}) => ({\n  paddingBottom: 32,\n  display: 'flex',\n  alignItems: 'center',\n  justifyContent: 'space-between',\n  flexDirection: 'column',\n  gap: 16,\n  [theme.breakpoints.up('md')]: {\n    flexDirection: 'row',\n  },\n}));\n\nconst TopBarRightSection = styled('div', {name: 'TopBarRightSection'})(({theme}) => ({\n  display: 'flex',\n  alignItems: 'center',\n  gap: 24,\n  boxShadow: `-18px 0 10px ${theme.palette.background.default}`,\n  position: 'relative',\n  zIndex: 1,\n  width: '100%',\n  pl: '16px',\n  [theme.breakpoints.up('md')]: {\n    width: 'auto',\n    paddingLeft: 0,\n  },\n}));\n","/Users/jesse/repos/telos-bridge/src/features/onft/ui/CardsGrid.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/onft/ui/DestinationPicker.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/onft/ui/GasOnDestinationDetailItem.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/onft/ui/GasOnDestinationPicker.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/onft/ui/NetworkFilter.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/onft/ui/NoAssetsPlaceholder.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/onft/ui/OnftBridge.tsx",[],[],"/Users/jesse/repos/telos-bridge/src/features/onft/ui/OnftCard.tsx",[],["801"],"/Users/jesse/repos/telos-bridge/src/features/onft/ui/OnftListItem.tsx",[],["802"],"/Users/jesse/repos/telos-bridge/src/features/onft/ui/TransferModal.tsx",[],["803","804"],"/Users/jesse/repos/telos-bridge/src/fe